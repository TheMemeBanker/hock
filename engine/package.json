{
  "name": "hock-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HOCK off-chain engine: attestor, gate, watcher, reconciler, canary, health.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "check": "for f in $(find src db -name \"*.js\"); do node --check $f || exit 1; done; echo check ok",
    "migrate": "node -e 'import(\"./db/migrations-runner.js\").then(m=>m.applyPendingMigrations()).then(r=>{console.log(r);process.exit(0)}).catch(e=>{console.error(e.message);process.exit(1)})'",
    "boot-check": "node src/index.js --boot-check"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@solana/spl-token": "^0.4.6",
    "@solana/web3.js": "^1.95.3",
    "axios": "^1.19.0",
    "bn.js": "^5.2.1",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.5",
    "pg": "^8.13.0",
    "tweetnacl": "^1.0.3"
  }
}
