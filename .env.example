# HOCK environment. Names only; real values live in the host's secret store, never in git.

# --- cluster ---
HOCK_CLUSTER=devnet                       # localnet | devnet | mainnet-beta
PROGRAM_ID=                               # hock_lending program id for this cluster (required, no fallback)
SOLANA_RPC_URL=                           # primary RPC (provider key stays server-side)
SOLANA_RPC_URL_BACKUP=                    # second provider; failover checks slot advance
SOLANA_RPC_URL_FALLBACK=                  # public endpoint for reads only

# --- engine keys (paths to keypair files outside the repo; the engine holds no user keys) ---
ENGINE_AUTHORITY_KEYPAIR_PATH=            # signs update_price, convert_collateral_slice, liquidate_loan only
ENGINE_GAS_KEYPAIR_PATH=                  # pays fees; topped up manually
POOL_PDA=                                 # the single live pool for v1

# --- prices ---
JUPITER_API_KEY=
JUPITER_PRICE_URL=https://api.jup.ag/price/v2
JUPITER_QUOTE_URL=https://api.jup.ag/swap/v1/quote
DEXSCREENER_URL=https://api.dexscreener.com
PYTH_HERMES_URL=https://hermes.pyth.network

# --- database ---
DATABASE_URL=
DATABASE_URL_READONLY=

# --- web ---
NEXT_PUBLIC_HOCK_CLUSTER=devnet
NEXT_PUBLIC_PROGRAM_ID=
NEXT_PUBLIC_POOL_PDA=                     # the live pool PDA (["pool", authority])
NEXT_PUBLIC_COSIGN_URL=                   # engine co-sign relay origin (e.g. https://engine.hock.fun); the site posts to <origin>/cosign/borrow
NEXT_PUBLIC_SITE_URL=https://hock.fun
RPC_PROXY_UPSTREAM=                       # server-only; the browser calls /api/rpc
RPC_PROXY_READS_PER_MINUTE=400            # per-IP read budget on /api/rpc
RPC_PROXY_WRITES_PER_MINUTE=40            # per-IP sendTransaction budget on /api/rpc
UPLOAD_RELAY_URL=                         # Cloudflare worker that holds PINATA_JWT
PUMPPORTAL_TRADE_LOCAL=https://pumpportal.fun/api/trade-local

# --- engine ops ---
ENGINE_INSTANCE_ID=engine-1
HEALTH_PORT=3001
FEED_TARGET_INTERVAL_SECONDS=45           # keeps every feed inside the 120 s staleness window with margin
GATE_INTERVAL_SECONDS=60
WATCHER_INTERVAL_SECONDS=5
CANARY_INTERVAL_MINUTES=30

# --- engine loops (added with the engine build; defaults shown) ---
POOL_AUTHORITY_KEYPAIR_PATH=              # optional; the program binds update_price and initialize_price_feed to pool.authority
ATTESTOR_MAX_DIVERGENCE_PCT=5             # reject a sample when agreeing sources differ by more than this
ATTESTOR_MIN_SOURCES=2                    # minimum agreeing price sources per attestation
GATE_REFERENCE_SELL_SOL=0.5                 # routability check sells this much SOL worth of the token
GATE_MAX_IMPACT_BPS=800                   # routability fails above this Jupiter price impact
GATE_MAX_TOP10_PCT=40                     # holders check: top-10 non-pool holders may hold at most this share
# Headline rule: a coin becomes collateral once its market cap clears this line.
GATE_MIN_MARKET_CAP_USD=50000
# Sellability floor under the headline rule (sized for a bonding-curve coin, not a graduated pool).
GATE_MIN_LIQUIDITY_USD=2500
GATE_MIN_VOLUME_24H_USD=5000
GATE_MIN_VOLUME_1H_USD=250
GATE_PASSES_TO_PROMOTE=2                  # consecutive full passes before collateral_ready
GATE_EXCLUDED_HOLDERS=                    # comma-separated wallets excluded from the holders check (pools, vaults)
WATCHER_FEED_MAX_AGE_SECONDS=90           # a fire needs a feed sample younger than this (chain limit is 120)
WATCHER_MAX_SLICE_BPS=2500                # TWAP-sized slice ceiling per convert_collateral_slice
WATCHER_SLIPPAGE_BPS=300                  # Jupiter quote slippage for each slice (program floor still applies)
WATCHER_MAX_SLICES_PER_FIRE=8
RECONCILER_INTERVAL_SECONDS=60             # also mirrors on-chain arm/disarm into limit_close_orders for the watcher
ARMED_ORDER_HEALTH_PROBE_INTERVAL_MS=60000
ENGINE_STALL_MS=300000                    # no loop progress for this long -> exit 1 for supervisor restart
ENGINE_GAS_HARD_FLOOR_SOL=0.02
ENGINE_GAS_WARN_FLOOR_SOL=0.10
ADMIN_ALERT_THROTTLE_MS=900000
OVERDUE_ALERT_GRACE_MINUTES=15            # reconciler alerts when an active loan is unliquidated this long past due (keeper canary)
LIMIT_CLOSE_DISABLED=false                # kill switch: true pauses every fire and liquidation
CANARY_WALLET_KEYPAIR_PATH=               # canary is a no-op until both canary vars are set
CANARY_MINT=
CANARY_LOAN_PDA=                          # existing canary loan (devnet) or operator loan (mainnet fire simulation)
CANARY_FULL_LIFECYCLE=false
JUPITER_API=https://lite-api.jup.ag/swap/v1   # quote + swap-instructions base used by the lifted Jupiter modules

# --- borrow co-sign (engine) ---
COSIGN_PORT=3002
COSIGN_MAX_LOAN_SOL=25
COSIGN_MAX_UTILISATION_BPS=8000
COSIGN_FEED_MAX_AGE_SECONDS=90

# --- synthetic markets (devnet/localnet ONLY; the engine exits at boot if this is true on mainnet-beta) ---
SYNTHETIC_MARKETS=false                   # gate + attestor read synthetic_markets rows instead of DexScreener/Jupiter
NEXT_PUBLIC_DEMO_WALLET=false           # test clusters only: in-page keypair wallet for drivers and demo recordings; ignored on mainnet-beta
HOCK_ALLOWED_ORIGINS=                     # comma-separated site origins allowed to call the co-sign relay (CORS); e.g. https://hock.fun
